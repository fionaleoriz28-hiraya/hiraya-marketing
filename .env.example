# Supabase — safe to use in the Lovable app when prefixed with VITE_
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# OpenAI — server-only; NEVER expose as VITE_OPENAI_API_KEY
OPENAI_API_KEY=
HIRAYA_MODEL=gpt-5.6-luna

# Stripe — server/Edge Function secrets only; never expose in VITE_ variables
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used by Stripe Checkout / Customer Portal
APP_URL=http://localhost:3000

# Stripe webhook endpoint after deploying the Supabase Edge Function:
# https://<project-ref>.supabase.co/functions/v1/stripe-webhook
